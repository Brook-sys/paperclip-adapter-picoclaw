{
  "name": "paperclip-adapter-picoclaw",
  "version": "0.1.36",
  "description": "Paperclip external adapter for PicoClaw Pico Protocol over WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./ui-parser": "./dist/ui-parser.js"
  },
  "files": [
    "dist"
  ],
  "paperclip": {
