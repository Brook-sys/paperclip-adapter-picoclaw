  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "paperclip",
    "adapter",
    "picoclaw",
    "pico",
    "websocket"
