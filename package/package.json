  "author": "",
  "license": "MIT",
  "dependencies": {
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@paperclipai/adapter-utils": "^2026.529.0",
    "@types/node": "^25.9.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@paperclipai/adapter-utils": "*"
  },
  "peerDependenciesMeta": {
    "@paperclipai/adapter-utils": {
      "optional": true
    }
